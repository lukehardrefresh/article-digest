# Copy to .env and edit. Never commit .env.

# ---- LLM backend ----
# "zai" (default) uses the z-ai-web-dev-sdk. Works out-of-the-box inside Z.AI; otherwise the
# SDK picks up auth from its own env (see z-ai-web-dev-sdk docs).
# "openai" uses any OpenAI-compatible /chat/completions endpoint.
LLM_PROVIDER=zai

# Only required when LLM_PROVIDER=openai
#OPENAI_API_KEY=sk-...
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_MODEL=gpt-4o-mini

# ---- Pipeline tuning (all optional) ----
# Where HTML + state are written. Defaults to ./output
#DIGEST_OUTPUT_DIR=/var/lib/article-digest
# Article recency window in days (default 7)
#DIGEST_DAYS_WINDOW=7
# Articles per LLM call (default 12)
#DIGEST_BATCH_SIZE=12

# ---- Cloudflare-protected feeds (Pivot to AI, Morning Brew) ----
# Command template; the token {url} is substituted with the feed URL.
# The command must print rendered HTML to stdout. Examples:
#   PAGE_READER_CMD="node page_reader.js {url}"
#   PAGE_READER_CMD="curl -sL --compressed {url}"
# If unset, those two sources are skipped with a warning.
#PAGE_READER_CMD=
